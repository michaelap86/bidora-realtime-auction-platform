# Copy to .env (or pass as environment variables) and change the values.
PORT=8130
# Where the SQLite database and uploaded photos are stored
DATA_DIR=./data
# Long random string used to sign login cookies
SESSION_SECRET=change-me-to-a-long-random-string
# Set to 1 when the site is served over https
COOKIE_SECURE=0
# Optional: creates a private admin account (admin@bidora.app) in addition to the demo accounts
ADMIN_PASSWORD=
# Demo behaviour: 1 = e-mail verification link is shown on screen, bots place bids, data resets nightly
DEMO_MODE=1
SIMULATE=1
NIGHTLY_RESET=1
